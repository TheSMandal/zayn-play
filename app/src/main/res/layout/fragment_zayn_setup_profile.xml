<?xml version="1.0" encoding="utf-8"?>
<!-- Zayn Play setup: Profile (step 1 of 6). Fresh build, v1.0.10.
     Replaces fragment_setup_profile.xml. The old centred "Your profile"
     title, photo-tile avatars, white Next / black Skip are gone; this is
     the preview setup: setup-top header, "Create your profile", letter
     tiles, red-gradient Next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Zayn Play setup-top header (preview .setup-top): logo mark +
         wordmark + step count. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/zayn_logo_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="ZAYN"
            android:textColor="?attr/textColor"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:text="PLAY"
            android:textColor="#FF5147"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zayn_setup_step_1_of_6"
            android:textColor="?attr/grayTextColor"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:text="@string/zayn_setup_profile_title"
        android:textColor="?attr/textColor"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="5dp"
        android:text="@string/zayn_setup_profile_sub"
        android:textColor="?attr/grayTextColor"
        android:textSize="13.5sp" />

    <ProgressBar
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="14dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:max="6"
        android:progress="1"
        android:progressDrawable="@drawable/zayn_setup_progress" />

    <!-- Dots row (preview .setup-dots): one dot per step, done = red. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/zayn_setup_dot_done" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/zayn_setup_dot" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/zayn_setup_dot" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/zayn_setup_dot" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/zayn_setup_dot" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/zayn_setup_dot" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Profile preview circle (preview .prof-preview): letter tile
                 + uploaded-photo overlay. -->
            <FrameLayout
                android:layout_width="86dp"
                android:layout_height="86dp">

                <TextView
                    android:id="@+id/profile_preview_letter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Z"
                    android:textColor="@android:color/white"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/profile_preview_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/zayn_avatar_circle"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/profile_preview_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/zayn_setup_profile_your_name"
                android:textColor="?attr/textColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Avatar grid: 8 letter tiles (preview .avatar-grid). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/profile_avatar_z"
                    android:layout_width="0dp"
                    android:layout_height="53dp"
                    android:layout_weight="1"
                    android:gravity="center">

                    <View
                        android:id="@+id/profile_avatar_z_ring"
                        android:layout_width="53dp"
                        android:layout_height="53dp"
                        android:layout_gravity="center"
                        android:background="@drawable/zayn_avatar_ring"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/profile_avatar_z_tile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="Z"
                        android:textColor="@android:color/white"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/profile_avatar_r"
                    android:layout_width="0dp"
                    android:layout_height="53dp"
                    android:layout_weight="1"
                    android:gravity="center">

                    <View
                        android:id="@+id/profile_avatar_r_ring"
                        android:layout_width="53dp"
                        android:layout_height="53dp"
                        android:layout_gravity="center"
                        android:background="@drawable/zayn_avatar_ring"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/profile_avatar_r_tile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="R"
                        android:textColor="@android:color/white"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/profile_avatar_a"
                    android:layout_width="0dp"
                    android:layout_height="53dp"
                    android:layout_weight="1"
                    android:gravity="center">

                    <View
                        android:id="@+id/profile_avatar_a_ring"
                        android:layout_width="53dp"
                        android:layout_height="53dp"
                        android:layout_gravity="center"
                        android:background="@drawable/zayn_avatar_ring"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/profile_avatar_a_tile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="@android:color/white"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/profile_avatar_s"
                    android:layout_width="0dp"
                    android:layout_height="53dp"
                    android:layout_weight="1"
                    android:gravity="center">

                    <View
                        android:id="@+id/profile_avatar_s_ring"
                        android:layout_width="53dp"
                        android:layout_height="53dp"
                        android:layout_gravity="center"
                        android:background="@drawable/zayn_avatar_ring"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/profile_avatar_s_tile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="S"
                        android:textColor="@android:color/white"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/profile_avatar_m"
                    android:layout_width="0dp"
                    android:layout_height="53dp"
                    android:layout_weight="1"
                    android:gravity="center">

                    <View
                        android:id="@+id/profile_avatar_m_ring"
                        android:layout_width="53dp"
                        android:layout_height="53dp"
                        android:layout_gravity="center"
                        android:background="@drawable/zayn_avatar_ring"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/profile_avatar_m_tile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="M"
                        android:textColor="@android:color/white"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/profile_avatar_n"
                    android:layout_width="0dp"
                    android:layout_height="53dp"
                    android:layout_weight="1"
                    android:gravity="center">

                    <View
                        android:id="@+id/profile_avatar_n_ring"
                        android:layout_width="53dp"
                        android:layout_height="53dp"
                        android:layout_gravity="center"
                        android:background="@drawable/zayn_avatar_ring"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/profile_avatar_n_tile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="N"
                        android:textColor="@android:color/white"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/profile_avatar_k"
                    android:layout_width="0dp"
                    android:layout_height="53dp"
                    android:layout_weight="1"
                    android:gravity="center">

                    <View
                        android:id="@+id/profile_avatar_k_ring"
                        android:layout_width="53dp"
                        android:layout_height="53dp"
                        android:layout_gravity="center"
                        android:background="@drawable/zayn_avatar_ring"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/profile_avatar_k_tile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="K"
                        android:textColor="@android:color/white"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/profile_avatar_t"
                    android:layout_width="0dp"
                    android:layout_height="53dp"
                    android:layout_weight="1"
                    android:gravity="center">

                    <View
                        android:id="@+id/profile_avatar_t_ring"
                        android:layout_width="53dp"
                        android:layout_height="53dp"
                        android:layout_gravity="center"
                        android:background="@drawable/zayn_avatar_ring"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/profile_avatar_t_tile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="T"
                        android:textColor="@android:color/white"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Upload your own photo (preview .upload-btn). -->
            <TextView
                android:id="@+id/profile_upload_button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/zayn_setup_upload_bg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/zayn_setup_profile_upload_photo"
                android:textColor="?attr/textColor"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/zayn_setup_profile_name_label"
                android:textColor="?attr/grayTextColor"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/profile_name_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/zayn_setup_input_bg"
                android:hint="@string/zayn_setup_profile_name_hint"
                android:imeOptions="actionDone"
                android:inputType="textPersonName"
                android:maxLength="30"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="?attr/textColor"
                android:textColorHint="?attr/grayTextColor"
                android:textSize="15.5sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/setup_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/skip_setup"
            android:textColor="?attr/grayTextColor"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setup_next"
            style="@style/ZaynWatchNowButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="140dp"
            android:text="@string/next"
            android:textColor="@android:color/white"
            android:textSize="15.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

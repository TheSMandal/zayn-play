<?xml version="1.0" encoding="utf-8"?>
<!-- Zayn Play splash #13 "Bokeh Nights" background: theme background with soft
     translucent bokeh circles. The logo/wordmark/tagline/credit are laid out in
     activity_splash.xml on top of this. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="?attr/primaryBlackBackground" />
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="top|left"
        android:left="16dp"
        android:top="36dp">
        <shape android:shape="oval">
            <solid android:color="#1AFF5147" />
        </shape>
    </item>
    <item
        android:width="56dp"
        android:height="56dp"
        android:gravity="top|right"
        android:right="28dp"
        android:top="96dp">
        <shape android:shape="oval">
            <solid android:color="#14FF7A1A" />
        </shape>
    </item>
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center"
        android:left="140dp"
        android:top="60dp">
        <shape android:shape="oval">
            <solid android:color="#1A7C3AED" />
        </shape>
    </item>
    <item
        android:width="110dp"
        android:height="110dp"
        android:gravity="bottom|right"
        android:right="8dp"
        android:bottom="48dp">
        <shape android:shape="oval">
            <solid android:color="#12E8261C" />
        </shape>
    </item>
    <item
        android:width="70dp"
        android:height="70dp"
        android:gravity="bottom|left"
        android:left="24dp"
        android:bottom="120dp">
        <shape android:shape="oval">
            <solid android:color="#14FFB03A" />
        </shape>
    </item>
</layer-list>

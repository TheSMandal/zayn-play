<?xml version="1.0" encoding="utf-8"?>
<!-- Splash #13, light (pearl) form: #fffdf8 -> #faf6ef -> #f2ebdf
     with soft warm bokeh dots. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FFFDF8"
                android:centerColor="#FAF6EF"
                android:endColor="#F2EBDF" />
        </shape>
    </item>
    <item android:left="250dp" android:top="60dp">
        <shape android:shape="oval">
            <size android:width="90dp" android:height="90dp" />
            <solid android:color="#14E8261C" />
        </shape>
    </item>
    <item android:left="30dp" android:top="300dp">
        <shape android:shape="oval">
            <size android:width="70dp" android:height="70dp" />
            <solid android:color="#102563EB" />
        </shape>
    </item>
    <item android:left="280dp" android:top="480dp">
        <shape android:shape="oval">
            <size android:width="56dp" android:height="56dp" />
            <solid android:color="#1AE8261C" />
        </shape>
    </item>
    <item android:left="60dp" android:top="620dp">
        <shape android:shape="oval">
            <size android:width="44dp" android:height="44dp" />
            <solid android:color="#14B3000C" />
        </shape>
    </item>
    <!-- Logo in the starting window, at exactly the layout's logo position:
         the layout centres the whole splash block (logo 104dp + 18dp gap +
         wordmark ~32dp + 10dp gap + tagline ~13dp + 26dp gap + dots 7dp,
         ≈210dp tall), so the logo centre sits ≈53dp ABOVE the true screen
         centre; bottom="106dp" shifts the centred 104dp logo up by that
         same 53dp, so it does not jump when the layout inflates. -->
    <item
        android:width="104dp"
        android:height="104dp"
        android:bottom="106dp"
        android:gravity="center"
        android:drawable="@drawable/ic_logo_mark" />
</layer-list>

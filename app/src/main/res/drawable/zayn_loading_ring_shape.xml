<?xml version="1.0" encoding="utf-8"?>
<!-- Zayn Play: loading ring shape (video 2 spec) — thin white arc with a gap.
     The sweep gradient fades from opaque white to transparent, so the ring
     reads as a "C"; the animated-rotate wrapper spins it clockwise. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="ring"
    android:innerRadius="17dp"
    android:thickness="3dp"
    android:useLevel="false">
    <gradient
        android:type="sweep"
        android:startColor="#FFFFFFFF"
        android:endColor="#00FFFFFF" />
</shape>

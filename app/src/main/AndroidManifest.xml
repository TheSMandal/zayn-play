<?xml version="1.0" encoding="utf-8"?>
<!-- Zayn Play — UI-only build (v0.1.0). No engine, no providers, no player:
     the whole UI is the approved preview, shown in a WebView. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Google Fonts (Hind Siliguri / Montserrat / Sora) load from the web;
         the UI falls back to system fonts when offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Phase C: wifiOnly download gate (ConnectivityManager) and
         download notifications (best-effort; no runtime request in 0.2.0). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phase C: external-player launch (VLC / MX Player / JustPlayer)
         needs package visibility on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.brouken.player" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Phase C: FileProvider for the updater (cacheDir/ZaynPlay.apk)
             and downloaded files. Authority is app.netlify.zaynplay.provider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.netlify.zaynplay.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Splash #13 (Bokeh Nights) — native, shows on cold start. -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The app itself: one WebView showing the approved preview UI.
             uiMode is handled in-app (no activity restart on theme change),
             so the WebView's prefers-color-scheme updates live. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|layoutDirection" />
    </application>
</manifest>
